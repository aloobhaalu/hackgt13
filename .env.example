# Development: copy to .env.local. Production: set these in the server environment.
# Never prefix secrets with VITE_. Empty key = deterministic local recap.
GEMINI_API_KEY=
# Optional model override; empty uses the server's existing default.
GEMINI_MODEL=
# Production-only local port; empty defaults to 3000. Bind address is always 127.0.0.1.
PORT=
