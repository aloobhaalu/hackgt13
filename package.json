{
  "name": "repready",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:server",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/pose/engine.test.ts src/pose/curl.test.ts src/pose/squat.test.ts src/pose/draw.test.ts src/camera.test.ts src/App.test.tsx src/recap/recap.test.ts server/app.test.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-server/index.mjs",
    "start": "node dist-server/index.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
